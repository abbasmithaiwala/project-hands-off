{
  "openapi": "3.1.0",
  "info": {
    "title": "Hands-Off API",
    "description": "Edit images by direct manipulation.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["system"],
        "summary": "Report that the server is up.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images": {
      "post": {
        "tags": ["images"],
        "summary": "Upload an image. Re-uploading identical bytes returns the existing record.",
        "operationId": "upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "An identical image already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageRecord"
                }
              }
            }
          },
          "201": {
            "description": "Image stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageRecord"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "File or dimensions too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported image type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}": {
      "get": {
        "tags": ["images"],
        "summary": "Fetch an image's metadata.",
        "operationId": "get_image",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageRecord"
                }
              }
            }
          },
          "404": {
            "description": "Unknown image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/analyze": {
      "post": {
        "tags": ["images"],
        "summary": "Start detecting and outlining the objects in an image.",
        "description": "The returned job streams one `object_found` event per object. Results are cached, so\nanalysing the same image again is instant.",
        "operationId": "analyze",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Analysis started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "404": {
            "description": "Unknown image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/objects": {
      "get": {
        "tags": ["images"],
        "summary": "List the objects found in an image.",
        "operationId": "list_objects",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detected objects, most confident first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DetectedObject"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown image, or it has not been analysed yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/objects/{object_id}/mask": {
      "get": {
        "tags": ["images"],
        "summary": "Download one object's mask as a grayscale PNG (white is the object).",
        "operationId": "get_mask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          },
          {
            "name": "object_id",
            "in": "path",
            "description": "Object index within the image",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mask PNG",
            "content": {
              "image/png": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown image or object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/objects/{object_id}/properties": {
      "post": {
        "tags": ["objects"],
        "summary": "Suggest the properties that can be edited on an object.",
        "description": "Results are cached, so repeated calls are free. Calls a model on first use.",
        "operationId": "properties",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          },
          {
            "name": "object_id",
            "in": "path",
            "description": "Object index within the image",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyList"
                }
              }
            }
          },
          "404": {
            "description": "Unknown image or object, or not analysed yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No API key, no credits, or the models are unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/objects/{object_id}/widget": {
      "post": {
        "tags": ["objects"],
        "summary": "Place the on-canvas control for one property of an object.",
        "description": "Results are cached. The geometry is validated and snapped onto the object's mask; if the\nmodel cannot produce a usable plan, a sensible default placement is returned instead.",
        "operationId": "widget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          },
          {
            "name": "object_id",
            "in": "path",
            "description": "Object index within the image",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanWidget"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "404": {
            "description": "Unknown image, object or property",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No API key, no credits, or the models are unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/original": {
      "get": {
        "tags": ["images"],
        "summary": "Download the original image bytes.",
        "operationId": "get_original",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The original image",
            "content": {
              "image/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}/thumbnail": {
      "get": {
        "tags": ["images"],
        "summary": "Download a JPEG thumbnail.",
        "operationId": "get_thumbnail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Image id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ImageId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": ["jobs"],
        "summary": "Fetch a job's current state.",
        "operationId": "get_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRecord"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["jobs"],
        "summary": "Request cancellation of a job. Cancelling a finished job has no effect.",
        "operationId": "cancel_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested"
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/events": {
      "get": {
        "tags": ["jobs"],
        "summary": "Stream a job's events as server-sent events. Each event is a [`JobEvent`] JSON object;\nthe stream ends after the terminal event.",
        "operationId": "job_events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/JobId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/JobEvent"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": ["settings"],
        "summary": "Read the current settings.",
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/models": {
      "put": {
        "tags": ["settings"],
        "summary": "Choose the model for each AI stage. Any OpenRouter model id is accepted.",
        "operationId": "set_models",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          },
          "400": {
            "description": "A model id is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/openrouter-key": {
      "put": {
        "tags": ["settings"],
        "summary": "Save the OpenRouter API key. It is stored on the server and never returned.",
        "operationId": "set_key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetKey"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Key saved"
          },
          "400": {
            "description": "That does not look like an API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["settings"],
        "summary": "Remove the stored API key. A key set through the environment is unaffected.",
        "operationId": "clear_key",
        "responses": {
          "204": {
            "description": "Key removed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Axis": {
        "type": "object",
        "description": "A line segment along which a slider moves.",
        "required": ["start", "end"],
        "properties": {
          "end": {
            "$ref": "#/components/schemas/NormalizedPoint",
            "description": "Where the slider ends."
          },
          "start": {
            "$ref": "#/components/schemas/NormalizedPoint",
            "description": "Where the slider starts."
          }
        }
      },
      "BBox": {
        "type": "object",
        "description": "An axis-aligned box in normalised image coordinates.",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "height": {
            "type": "number",
            "format": "float",
            "description": "Height."
          },
          "width": {
            "type": "number",
            "format": "float",
            "description": "Width."
          },
          "x": {
            "type": "number",
            "format": "float",
            "description": "Left edge."
          },
          "y": {
            "type": "number",
            "format": "float",
            "description": "Top edge."
          }
        }
      },
      "ContentHash": {
        "type": "string",
        "description": "Lowercase hex SHA-256 digest of an image's bytes."
      },
      "DetectedObject": {
        "type": "object",
        "description": "An object found in an image.",
        "required": ["id", "label", "bbox", "score", "outline"],
        "properties": {
          "bbox": {
            "$ref": "#/components/schemas/BBox",
            "description": "Bounding box."
          },
          "id": {
            "$ref": "#/components/schemas/ObjectId",
            "description": "Index within the image."
          },
          "label": {
            "type": "string",
            "description": "Human-readable class label."
          },
          "outline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NormalizedPoint"
            },
            "description": "Simplified outline of the object's mask, as a closed polygon."
          },
          "score": {
            "type": "number",
            "format": "float",
            "description": "Detector confidence in `0.0..=1.0`."
          }
        }
      },
      "Edit": {
        "type": "object",
        "description": "One user edit on one object property.",
        "required": ["object_id", "property", "change"],
        "properties": {
          "change": {
            "$ref": "#/components/schemas/EditChange",
            "description": "What the user changed."
          },
          "object_id": {
            "$ref": "#/components/schemas/ObjectId",
            "description": "Object being edited."
          },
          "property": {
            "type": "string",
            "description": "Property key being edited."
          }
        }
      },
      "EditChange": {
        "oneOf": [
          {
            "type": "object",
            "description": "A slider moved to `value`.",
            "required": ["value", "kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["slider"]
              },
              "value": {
                "type": "number",
                "format": "float",
                "description": "New value."
              }
            }
          },
          {
            "type": "object",
            "description": "Points moved from `origin` to `target`.",
            "required": ["origin", "target", "kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["control_points"]
              },
              "origin": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Positions before the edit."
              },
              "target": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Positions after the edit."
              }
            }
          },
          {
            "type": "object",
            "description": "Handles moved from `origin` to `target`.",
            "required": ["origin", "target", "kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["multi_handle"]
              },
              "origin": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Positions before the edit."
              },
              "target": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Positions after the edit."
              }
            }
          }
        ],
        "description": "The change a user made with a widget."
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON body of every error response.",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine-readable code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable error identifiers exposed through the API.",
        "enum": [
          "validation",
          "unsupported_media",
          "payload_too_large",
          "not_found",
          "timeout",
          "cancelled",
          "unavailable",
          "internal"
        ]
      },
      "Health": {
        "type": "object",
        "description": "Liveness report.",
        "required": ["status", "version"],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the server is running."
          },
          "version": {
            "type": "string",
            "description": "Server version."
          }
        }
      },
      "ImageFormat": {
        "type": "string",
        "description": "Supported upload formats.",
        "enum": ["jpeg", "png", "webp"]
      },
      "ImageId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifier of an uploaded image."
      },
      "ImageRecord": {
        "type": "object",
        "description": "Metadata of an uploaded image.",
        "required": ["id", "hash", "format", "width", "height", "size_bytes", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload time."
          },
          "format": {
            "$ref": "#/components/schemas/ImageFormat",
            "description": "Detected format."
          },
          "hash": {
            "$ref": "#/components/schemas/ContentHash",
            "description": "SHA-256 of the original bytes; identical uploads share one record."
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "description": "Height in pixels.",
            "minimum": 0
          },
          "id": {
            "$ref": "#/components/schemas/ImageId",
            "description": "Unique identifier."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size of the original file in bytes.",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "Width in pixels.",
            "minimum": 0
          }
        }
      },
      "JobCreated": {
        "type": "object",
        "description": "Reference to a newly started background job.",
        "required": ["job_id"],
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/JobId",
            "description": "Use with the `/jobs/{id}` routes to follow progress."
          }
        }
      },
      "JobEvent": {
        "oneOf": [
          {
            "type": "object",
            "description": "A pipeline stage started or advanced.",
            "required": ["stage", "message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "description": "Human-readable description."
              },
              "stage": {
                "type": "string",
                "description": "Stage name, for example `generating`."
              },
              "type": {
                "type": "string",
                "enum": ["progress"]
              }
            }
          },
          {
            "type": "object",
            "description": "A line of reasoning or diagnostics for the output panel.",
            "required": ["line", "type"],
            "properties": {
              "line": {
                "type": "string",
                "description": "The log line."
              },
              "type": {
                "type": "string",
                "enum": ["log"]
              }
            }
          },
          {
            "type": "object",
            "description": "An object was found during image analysis.",
            "required": ["object", "type"],
            "properties": {
              "object": {
                "$ref": "#/components/schemas/DetectedObject",
                "description": "The detected object."
              },
              "type": {
                "type": "string",
                "enum": ["object_found"]
              }
            }
          },
          {
            "type": "object",
            "description": "The job finished successfully.",
            "required": ["type"],
            "properties": {
              "result": {
                "type": ["object", "null"],
                "description": "Optional job-specific result payload."
              },
              "type": {
                "type": "string",
                "enum": ["completed"]
              }
            }
          },
          {
            "type": "object",
            "description": "The job failed.",
            "required": ["code", "message", "type"],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode",
                "description": "Stable error code."
              },
              "message": {
                "type": "string",
                "description": "Human-readable message."
              },
              "type": {
                "type": "string",
                "enum": ["failed"]
              }
            }
          },
          {
            "type": "object",
            "description": "The job was cancelled.",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["cancelled"]
              }
            }
          }
        ],
        "description": "An event streamed to clients while a job runs."
      },
      "JobId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifier of a background job."
      },
      "JobRecord": {
        "type": "object",
        "description": "Persisted summary of a job.",
        "required": ["id", "kind", "status", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the job was created."
          },
          "error_code": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorCode",
                "description": "Failure code when `status` is `failed`."
              },
              {
                "type": "null"
              }
            ]
          },
          "error_message": {
            "type": ["string", "null"],
            "description": "Failure message when `status` is `failed`."
          },
          "finished_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the job reached a terminal state."
          },
          "id": {
            "$ref": "#/components/schemas/JobId",
            "description": "Unique identifier."
          },
          "kind": {
            "type": "string",
            "description": "What the job does, for example `analyze`."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
            "description": "Current state."
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "description": "Lifecycle state of a job.",
        "enum": ["running", "completed", "failed", "cancelled"]
      },
      "KeyOrigin": {
        "type": "string",
        "description": "Where the OpenRouter key comes from.",
        "enum": ["environment", "stored", "demo", "none"]
      },
      "KeyStatus": {
        "type": "object",
        "description": "Whether AI features can run, without revealing any secret.",
        "required": ["configured", "origin"],
        "properties": {
          "configured": {
            "type": "boolean",
            "description": "True when AI requests can be made."
          },
          "origin": {
            "$ref": "#/components/schemas/KeyOrigin",
            "description": "Where the key comes from."
          }
        }
      },
      "ModelSettings": {
        "type": "object",
        "description": "Which model each AI stage uses. Any OpenRouter model id is allowed, including\n`typesafe/jev-router`, which picks a model and reasoning effort per request.",
        "required": ["suggester", "ui_planner", "summariser", "generator", "fallback"],
        "properties": {
          "fallback": {
            "type": "string",
            "description": "Tried when the stage's own model fails or is unavailable."
          },
          "generator": {
            "type": "string",
            "description": "Generates the edited image."
          },
          "suggester": {
            "type": "string",
            "description": "Suggests editable properties for an object."
          },
          "summariser": {
            "type": "string",
            "description": "Summarises edits into instructions and change logs."
          },
          "ui_planner": {
            "type": "string",
            "description": "Plans where a control sits on the canvas."
          }
        }
      },
      "NormalizedPoint": {
        "type": "object",
        "description": "A point in normalised image coordinates (origin top-left).",
        "required": ["x", "y"],
        "properties": {
          "x": {
            "type": "number",
            "format": "float",
            "description": "Horizontal position, `0.0` left to `1.0` right."
          },
          "y": {
            "type": "number",
            "format": "float",
            "description": "Vertical position, `0.0` top to `1.0` bottom."
          }
        }
      },
      "ObjectId": {
        "type": "integer",
        "format": "int32",
        "description": "Index of a detected object within one image.",
        "minimum": 0
      },
      "PlanWidget": {
        "type": "object",
        "description": "Which property to place a control for.",
        "required": ["property"],
        "properties": {
          "property": {
            "type": "string",
            "description": "A property key returned by the properties route."
          }
        }
      },
      "Property": {
        "type": "object",
        "description": "An editable property of an object.",
        "required": ["key", "label", "widget"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable key, for example `length`."
          },
          "label": {
            "type": "string",
            "description": "Label shown to the user."
          },
          "widget": {
            "$ref": "#/components/schemas/WidgetKind",
            "description": "Control used to edit it."
          }
        }
      },
      "PropertyList": {
        "type": "object",
        "description": "The editable properties suggested for one object.",
        "required": ["properties"],
        "properties": {
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Property"
            },
            "description": "Properties, most useful first."
          }
        }
      },
      "SetKey": {
        "type": "object",
        "description": "Body for saving an API key.",
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string",
            "description": "The OpenRouter API key."
          }
        }
      },
      "SettingsView": {
        "type": "object",
        "description": "Current settings.",
        "required": ["openrouter", "models"],
        "properties": {
          "models": {
            "$ref": "#/components/schemas/ModelSettings",
            "description": "The model used by each AI stage."
          },
          "openrouter": {
            "$ref": "#/components/schemas/KeyStatus",
            "description": "State of the OpenRouter key."
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "description": "Multipart form accepted by the upload endpoint.",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The image file (JPEG, PNG or WebP)."
          }
        }
      },
      "Widget": {
        "oneOf": [
          {
            "type": "object",
            "description": "A slider scaling a property between `min` and `max`.",
            "required": ["axis", "min", "max", "initial", "kind"],
            "properties": {
              "axis": {
                "$ref": "#/components/schemas/Axis",
                "description": "Line the handle moves along."
              },
              "initial": {
                "type": "number",
                "format": "float",
                "description": "Starting value."
              },
              "kind": {
                "type": "string",
                "enum": ["slider"]
              },
              "max": {
                "type": "number",
                "format": "float",
                "description": "Highest allowed value."
              },
              "min": {
                "type": "number",
                "format": "float",
                "description": "Lowest allowed value."
              }
            }
          },
          {
            "type": "object",
            "description": "Control points forming a shape.",
            "required": ["points", "kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["control_points"]
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Initial point positions."
              }
            }
          },
          {
            "type": "object",
            "description": "Independent handles.",
            "required": ["handles", "kind"],
            "properties": {
              "handles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NormalizedPoint"
                },
                "description": "Initial handle positions."
              },
              "kind": {
                "type": "string",
                "enum": ["multi_handle"]
              }
            }
          }
        ],
        "description": "Placement and geometry of a control on the canvas."
      },
      "WidgetKind": {
        "type": "string",
        "description": "The kind of on-canvas control used to edit a property.",
        "enum": ["slider", "control_points", "multi_handle"]
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Server status"
    },
    {
      "name": "images",
      "description": "Upload and fetch images"
    },
    {
      "name": "objects",
      "description": "AI-assisted controls for detected objects"
    },
    {
      "name": "settings",
      "description": "API key and model choices"
    },
    {
      "name": "jobs",
      "description": "Background jobs and their event streams"
    }
  ]
}
